# The build context is THIS repository only; sluice arrives through a named
# BuildKit context (see Dockerfile). These patterns keep local state and
# anything credential-shaped out of the image and off the daemon.
.git
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
samples
*.db
*.sqlite*
secrets*
*.key
*.pem
